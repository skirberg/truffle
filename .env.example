# Every variable here is optional. With none of them set, the site runs on the sample committed in data/.
# Copy this file to .env.local and fill in only what you use. Never commit a real value.

# Optional. Postgres with PostGIS and pg_trgm, loaded with lots by a pull. Without it the site reads data/snapshot.json.gz.
DATABASE_URL=

# Optional. The site's public address, for canonical links, robots, the sitemap and share cards. Defaults to https://www.truffle.city.
NEXT_PUBLIC_SITE_URL=

# Optional. A public URL of lots.pmtiles. Without it the site serves data/tiles/lots.pmtiles at /tiles/lots.pmtiles.
NEXT_PUBLIC_TILES_URL=

# Optional. A public URL of basemap.pmtiles. Without it the site serves data/tiles/basemap.pmtiles at /tiles/basemap.pmtiles.
NEXT_PUBLIC_BASEMAP_URL=

# Optional. A long random string. POST /api/revalidate with it as a bearer token to expire the cached pages after a pull; unset, the route refuses every call.
REVALIDATE_SECRET=
