  "role": {
    "$type": "color",
    "$description": "The semantic layer: what each color does. CSS and the contrast check read roles; a mode moves a role to another primitive, and the primitives above never change.",
    "surface": {
      "ground": {
        "$value": "{color.paper}"
      },
      "raised": {
        "$value": "{color.card}"
      },
      "inverse": {
        "$value": "{color.truffle}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.truffle}"
      },
      "secondary": {
        "$value": "{color.soft}",
        "$extensions": {
          "city.truffle.modes": {
            "contrastMore": "{color.truffleSide}"
          }
        }
      },
      "source": {
        "$value": "{color.faint}",
        "$extensions": {
          "city.truffle.modes": {
            "contrastMore": "{color.truffleSide}"
          }
        }
      },
      "onInverse": {
        "$value": "{color.paper}"
      }
    },
    "border": {
      "hairline": {
        "$value": "{color.line}",
        "$extensions": {
          "city.truffle.modes": {
            "contrastMore": "{color.soft}"
          }
        }
      },
      "focus": {
        "$value": "{color.truffle}"
      }
    },
    "accent": {
      "picked": {
        "$value": "{color.truffle}"
      },
      "pickedSide": {
        "$value": "{color.truffleSide}"
      }
    },
    "state": {
      "calledRight": {
        "$value": "{color.truffle}"
      },
      "missed": {
        "$value": "{role.text.secondary}"
      }
    }
  },
