  "colorNote": "Use colors are [top, left side, right side]. Light comes from the upper left. Color means use (or what the zoning allows, in Rules); height means value; truffle brown means the lot you picked. Water is not a use: it is the civic blue at 45% over paper, set down as one flat color, so a river never reads as a park.",
  "role": {
    "$description": "The semantic layer: what each color does. CSS and the contrast check read roles; a mode moves a role to another primitive, and the primitives above never change. Values are references to color tokens, written {group.token}.",
    "surface": {
      "ground": "{color.paper}",
      "raised": "{color.card}",
      "inverse": "{color.truffle}"
    },
    "text": {
      "primary": "{color.truffle}",
      "secondary": "{color.soft}",
      "source": "{color.faint}",
      "onInverse": "{color.paper}"
    },
    "border": {
      "hairline": "{color.line}",
      "focus": "{color.truffle}"
    },
    "accent": {
      "picked": "{color.truffle}",
      "pickedSide": "{color.truffleSide}"
    },
    "state": {
      "calledRight": "{color.truffle}",
      "missed": "{role.text.secondary}"
    }
  },
  "modes": {
    "contrastMore": {
      "$description": "For anyone who asks their device for more contrast (prefers-contrast: more): secondary and source text move to the darker brand ink (9.3:1 on paper), hairlines to the secondary ink. Nothing else changes; color still means use.",
      "media": "(prefers-contrast: more)",
      "set": {
        "role.text.secondary": "{color.truffleSide}",
        "role.text.source": "{color.truffleSide}",
        "role.border.hairline": "{color.soft}"
      }
    }
  },
